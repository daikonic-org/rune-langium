namespace cdm.observable.asset : <"Observable concepts applicable to assets: price, reference price, valuation method etc.">
version "${project.version}"

import cdm.base.math.*
import cdm.observable.asset.*

func InterestRateObservableCondition: <"Implementation for PriceQuantity.InterestRateObservable condition.">
    inputs:
        pq PriceQuantity (1..1)
    output:
        valid boolean (0..1)

    set valid:
        if pq -> observable as InterestRateIndex exists and pq -> price exists
        then pq -> price
                extract [
                    priceType = PriceTypeEnum -> InterestRate and arithmeticOperator exists
                ] all = True

func ObservableIsCommodity: <"Validates whether all of the constituents of an Observable are Commodities.">
    inputs:
        observable Observable (0..1)
    output:
        valid boolean (1..1)

    set valid:
        if observable as Commodity exists
        then True
        else if observable as Basket exists
        then observable as Basket -> basketConstituent
                extract [ observable as Commodity exists ]
            all = True
        else if observable as Index exists
        then observable as Index ->> assetClass = Commodity
        else False
