namespace scope.rules
import scope.types.*
reporting rule Engine from Envelope:
 vehicle switch
  Powered then engine,
  default empty
reporting rule Forward from Envelope: Engine
reporting rule ReadKind from Envelope: extract Forward -> kind
reporting rule Registration from Vehicle:
 extract item ->> specification -> registeredOn
eligibility rule IsRegistered from Vehicle:
 item ->> specification -> registeredOn exists
reporting rule ManyEngines from Envelope: extract vehicle ->> engine
reporting rule ManyKinds from Envelope: ManyEngines -> kind
