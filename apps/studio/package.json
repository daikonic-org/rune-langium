{
  "name": "@rune-langium/studio",
  "version": "0.3.0",
  "private": true,
  "description": "Standalone web application for visual editing of Rune DSL models",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "check-env": "node scripts/check-env.mjs",
    "clean": "rm -rf dist",
    "predev": "pnpm dev:cleanup",
    "dev": "vite",
    "dev:pages": "wrangler pages dev --proxy 5173 --port 8788 --compatibility-date 2025-09-23 --compatibility-flags nodejs_compat",
    "dev:cleanup": "sh scripts/dev-cleanup.sh",
    "predev:full": "pnpm dev:cleanup",
    "dev:full": "concurrently --kill-others-on-fail -n vite,lsp,mirror,pages -c blue,green,yellow,magenta \"pnpm dev\" \"pnpm --filter @rune-langium/lsp-worker dev\" \"pnpm --filter @rune-langium/curated-mirror-worker dev\" \"pnpm dev:pages\"",
    "lint": "oxlint .",
    "lint:css": "stylelint 'src/**/*.css'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:z2f-hmr": "PLAYWRIGHT_ISOLATED_SERVER=1 playwright test test/e2e/z2f-hmr.spec.ts --retries=0",
    "test:prod-smoke": "PLAYWRIGHT_PROD_SMOKE=1 playwright test --config playwright.prod.config.ts prod-smoke",
    "test:prod-ux": "PLAYWRIGHT_PROD_SMOKE=1 playwright test --config playwright.prod.config.ts prod-ux/journeys",
    "telemetry:digest": "node scripts/telemetry-digest.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@hookform/resolvers": "^5.9.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@l1xnan/tree-sitter-sql": "0.4.7",
    "@lezer/highlight": "^1.2.5",
    "@lspeasy/core": "^3.0.1",
    "@marsidev/react-turnstile": "^1.6.2",
    "@rune-langium/codegen": "workspace:*",
    "@rune-langium/codegen-legacy": "workspace:*",
    "@rune-langium/core": "workspace:*",
    "@rune-langium/curated-schema": "workspace:*",
    "@rune-langium/design-system": "workspace:*",
    "@rune-langium/git-sync-engine": "workspace:*",
    "@rune-langium/instrumentation-core": "workspace:*",
    "@rune-langium/lsp-server": "workspace:*",
    "@rune-langium/project-config": "workspace:*",
    "@rune-langium/visual-editor": "workspace:*",
    "@tanstack/react-virtual": "^3.14.21",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@wasm-fmt/ruff_fmt": "^0.15.20",
    "@xyflow/react": "^12.12.0",
    "buffer": "^6.0.3",
    "codemirror": "6.0.2",
    "dockview-react": "^8.6.0",
    "idb": "^8.0.4",
    "isomorphic-git": "^1.44.3",
    "jszip": "^3.10.2",
    "langium": "^4.4.0",
    "lucide-react": "^1.59.0",
    "pako": "^3.0.2",
    "pino": "^10.4.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sucrase": "3.35.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15",
    "@rune-langium/project-runtime": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zod-to-form/core": "0.12.0",
    "@zod-to-form/vite": "0.5.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
