{
  "name": "@rune-langium/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site and generated agent skills for rune-langium APIs",
  "scripts": {
    "docs:api": "typedoc --options .vitepress/typedoc.json && node scripts/postprocess-skills.mjs",
    "dev": "pnpm run docs:api && vitepress dev",
    "build": "pnpm run docs:api && vitepress build",
    "build:combined": "node scripts/build-combined.mjs",
    "preview": "vitepress preview"
  },
  "dependencies": {
    "@rune-langium/design-system": "workspace:*"
  },
  "devDependencies": {
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-plugin-skillit": "^2.0.4",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
