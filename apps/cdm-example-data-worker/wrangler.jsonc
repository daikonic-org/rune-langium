{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rune-cdm-example-data",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "worker_loaders": [{ "binding": "EXECUTION_LOADER" }],
  "vars": { "EXECUTION_ALLOWED_GITHUB_IDS": "" },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rune-cdm-example-data",
      "database_id": "37b42f1a-7101-4ccd-936c-0f70ca4d682c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "rune-cdm-example-data"
    }
  ]
}
