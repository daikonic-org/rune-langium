{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "../..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "test/**/*.ts",
    "scripts/explicit-decorators.ts",
    "vitest-decorator-plugin.ts"
  ],
  "exclude": ["node_modules", "dist", "test/fixtures"]
}
