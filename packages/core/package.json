{
  "name": "@rune-langium/core",
  "version": "0.1.0",
  "description": "Langium-based parser and typed AST for the Rune DSL (.rosetta files)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod-schemas": {
      "types": "./dist/generated/zod-schemas.d.ts",
      "default": "./dist/generated/zod-schemas.js"
    },
    "./project-contract": {
      "types": "./dist/references/project-contract.d.ts",
      "import": "./dist/references/project-contract.js"
    },
    "./serialization": {
      "types": "./dist/serialization/rune-json.d.ts",
      "import": "./dist/serialization/rune-json.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc -b --watch",
    "generate": "langium generate && langium-zod generate && oxfmt src/generated/zod-schemas.ts",
    "generate:zod": "langium-zod generate && oxfmt src/generated/zod-schemas.ts",
    "generate:domain": "langium-zod generate --namespace-ops --namespace-ops-out src/generated/domain.ts --domain-surface-config domain-surface.config.json && oxlint --fix src/generated/domain.ts && oxfmt src/generated/domain.ts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "langium": "^4.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "langium-cli": "^4.4.0",
    "langium-zod": "0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/rune-langium.git",
    "directory": "packages/core"
  },
  "keywords": [
    "rune",
    "rosetta",
    "dsl",
    "langium",
    "parser",
    "ast",
    "cdm",
    "isda"
  ],
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "publishConfig": {
    "access": "public"
  }
}
