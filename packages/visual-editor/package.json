{
  "name": "@rune-langium/visual-editor",
  "version": "0.2.0",
  "description": "ReactFlow-based visual editor component library for Rune DSL type hierarchies",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./components": "./src/components.ts",
    "./model": "./src/model.ts",
    "./identifiers": "./src/store/node-projection.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -b && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc -b --watch",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "oxlint .",
    "lint:css": "stylelint 'src/**/*.css'",
    "generate:schemas": "langium-zod generate --config ../core/langium-config.json --out src/generated/zod-schemas.ts --strip-internals --projection form-surfaces.json --cross-ref-validation --conformance --ast-types ../core/src/generated/ast.ts --conformance-out src/generated/zod-schemas.conformance.ts && oxfmt src/generated/zod-schemas.ts src/generated/zod-schemas.conformance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@rune-langium/codegen": "workspace:*",
    "@rune-langium/core": "workspace:*",
    "@rune-langium/design-system": "workspace:*",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "@zod-to-form/core": "0.12.0",
    "@zod-to-form/react": "0.13.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.52.0",
    "mutative": "^1.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zod-to-form/vite": "0.5.0",
    "jsdom": "^30.1.2",
    "langium-zod": "0.12.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/rune-langium.git",
    "directory": "packages/visual-editor"
  },
  "keywords": [
    "rune",
    "rosetta",
    "dsl",
    "visual-editor",
    "reactflow",
    "graph",
    "type-hierarchy"
  ],
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "publishConfig": {
    "access": "public"
  }
}
