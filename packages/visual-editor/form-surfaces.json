{
  "_comment": [
    "Form-surface projection for canonical generated Inspector schemas.",
    "Shared root and child metadata fields stay declared for L1 field validation.",
    "Langium runtime fields are removed by --strip-internals."
  ],
  "defaults": {
    "strip": ["$container", "$document", "$cstNode", "$containerProperty", "$containerIndex"]
  },
  "types": {
    "RosettaEnumeration": {
      "fields": ["name", "parent", "enumValues", "definition", "annotations", "synonyms", "references"]
    },
    "Data": {
      "fields": ["name", "superType", "attributes", "definition", "annotations", "synonyms", "references"]
    },
    "Attribute": {
      "fields": [
        "name",
        "typeCall",
        "card",
        "definition",
        "annotations",
        "synonyms",
        "references",
        "labels",
        "ruleReferences",
        "override",
        "typeCallArgs"
      ]
    },
    "RosettaFunction": {
      "fields": ["name", "inputs", "output", "definition", "annotations", "references"]
    },
    "Choice": {
      "fields": ["name", "attributes", "definition", "annotations", "synonyms"]
    },
    "RosettaTypeAlias": {
      "fields": ["name", "typeCall", "definition"]
    }
  }
}
