{
  "name": "@rune-langium/worker-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Cloudflare Worker infrastructure: structured logging and redaction (./log), origin allowlist matching (./origin), and JSON/CORS responses (./http).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js"
    },
    "./origin": {
      "types": "./dist/origin.d.ts",
      "import": "./dist/origin.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@pinojs/redact": "^0.4.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
