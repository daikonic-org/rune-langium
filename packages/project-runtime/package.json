{
  "name": "@rune-langium/project-runtime",
  "version": "0.1.0",
  "description": "Shared Rune project builds and native filesystem host",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/project-build.d.ts",
      "import": "./dist/project-build.js"
    },
    "./references": {
      "types": "./dist/references/index.d.ts",
      "import": "./dist/references/index.js"
    },
    "./receipt": {
      "types": "./dist/project-receipt.d.ts",
      "import": "./dist/project-receipt.js"
    },
    "./effective": {
      "types": "./dist/effective-project.d.ts",
      "import": "./dist/effective-project.js"
    },
    "./resolution": {
      "types": "./dist/resolution.d.ts",
      "import": "./dist/resolution.js"
    },
    "./context": {
      "types": "./dist/project-context.d.ts",
      "import": "./dist/project-context.js"
    },
    "./status": {
      "types": "./dist/import/project-status.d.ts",
      "import": "./dist/import/project-status.js"
    },
    "./data": {
      "types": "./dist/project-data.d.ts",
      "import": "./dist/project-data.js"
    },
    "./examples": {
      "types": "./dist/reference-examples.d.ts",
      "import": "./dist/reference-examples.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@rune-langium/codegen": "workspace:*",
    "@rune-langium/core": "workspace:*",
    "@rune-langium/curated-schema": "workspace:*",
    "@rune-langium/project-config": "workspace:*",
    "langium": "^4.4.0",
    "pako": "^3.0.2",
    "semver": "7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^26.6.5",
    "@types/semver": "7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
