override namespace cdm.product.common.schedule
version "1.0.0"

import cdm.base.datetime.*

func CalculationPeriodRange: <"Construct a half-open range from the supplied dates. The handwritten CDM 7.9.0 implementation leaves dateAdjustments unused.">
    inputs:
        startDate date (0..1)
        endDate date (0..1)
        dateAdjustments BusinessDayAdjustments (0..1)
    output:
        result CalculationPeriodData (1..1)

    alias datesPresent:
        startDate exists and endDate exists
    condition DatesPresent:
        datesPresent
    condition OrderedDates:
        if datesPresent then startDate <= endDate else True

    set result: CalculationPeriodData {
        startDate: startDate,
        endDate: endDate,
        daysInPeriod: DateDifference(startDate, endDate),
        daysInLeapYearPeriod: LeapYearDateDifference(startDate, endDate),
        isFirstPeriod: False,
        isLastPeriod: False
    }
