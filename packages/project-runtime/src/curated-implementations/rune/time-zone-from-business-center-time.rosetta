override namespace cdm.base.datetime
version "1.0.0"

import impl.cdm.time.*

func TimeZoneFromBusinessCenterTime:
    inputs:
        time BusinessCenterTime (1..1)
    output:
        result TimeZone (1..1)

    alias center: time -> businessCenter
    alias scheme: time -> businessCenter -> scheme
    alias zones: ReadBusinessCenterZones(time)
    alias matches: zones filter [
        item -> businessCenter = center
        and MatchTimeScheme(scheme, item -> businessCenter -> scheme)
    ]
    alias selected: matches only-element
    condition BusinessCenterZoneMissing:
        matches exists
    condition BusinessCenterZoneAmbiguous:
        matches count = 1
    set result: TimeZone {
        time: time -> hourMinuteTime,
        location: selected -> location
    }
