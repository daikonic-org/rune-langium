override namespace cdm.base.datetime
version "1.0.0"

import cdm.base.staticdata.codelist.*
import com.opengamma.strata.basics.date.*

func BusinessCenterHolidays: <"Return the holiday records in the pinned Strata calendar for this business center.">
    inputs: businessCenter BusinessCenter (1..1)
    output: holidayDates date (0..*)

    set holidayDates:
        PinnedHolidayCalendar(businessCenter) -> holidays
            then extract [CalendarDate(item)]
